# Corridor environment configuration.
#
# Production (server holds all secrets; the browser never sees a key):
#   - DATABASE_URL:   PostgreSQL connection string. When unset, dev falls back
#                     to SQLite (node:sqlite, experimental).
#   - SESSION_SECRET: HMAC secret for signing session + customer-grant tokens.
#                     REQUIRED in production (NODE_ENV=production) — the server
#                     refuses to boot without it.
#   - LLM_KEY:        Anthropic API key (server-side only). The /api/llm/ask
#                     proxy uses it; the browser never receives it.
#   - TOMTOM_KEY:     TomTom traffic flow API key (server-side only).
#   - OSRM_URL:       OSRM routing endpoint (defaults to the public router).
#   - PORT:           server port (default 8787).
#   - RUN_SIM:        "true" to run the synthetic simulator server-side (demo
#                     deploys). Production leaves it unset — data comes from
#                     integrations, not the sim.
#   - INTEGRATION_API_KEY: shared secret required by ELD/order webhooks.
#   - CORS_ORIGINS:   optional comma-separated browser origins in addition to
#                     the same-origin production client.
#
# Dev-only (browser):
#   - VITE_SERVER_URL: when set, the browser connects to this server for the SSE
#                     stream, commands, and proxied external services. When
#                     unset (pure local dev), the browser runs its own seeded
#                     demo simulator, labelled "Demo sim".

DATABASE_URL=
SESSION_SECRET=
LLM_KEY=
TOMTOM_KEY=
OSRM_URL=
PORT=8787
RUN_SIM=
INTEGRATION_API_KEY=
CORS_ORIGINS=

# Dev only. `npm run dev` supplies http://localhost:8787 automatically.
VITE_SERVER_URL=
